# Required: Postgres connection string from Neon (use pooled endpoint in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required: 32+ char secret used to sign owner session JWTs (HS256 via jose).
# JWT access tokens now expire in 24 hours (was 1 year). Refresh tokens expire in 7 days.
JWT_SECRET=replace-with-a-long-random-secret-please

# Required: 32+ char secret used with PBKDF2 (100k iterations) to encrypt Kalshi API credentials at rest.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Required: single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-owner-password

# Required in production for Vercel cron auth. Must be at least 32 characters in production.
# Cron jobs send: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required: Claude is the sole AI reviewer for both Kalshi and Polymarket.
# The bots route each candidate signal through a category-specialized desk
# persona (sports / crypto / politics / economics / tech / culture / weather)
# with prompt caching, web_search, and extended thinking enabled.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5 for normal-stakes review.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional request timeout override in milliseconds; defaults to 12000.
ANTHROPIC_TIMEOUT_MS=12000
# Optional: cheap/fast model used for triage filtering (defaults to claude-haiku-4-5).
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5
# Optional: deep-reasoning model used on high-stakes trades when extended thinking is on.
ANTHROPIC_DEEP_MODEL=claude-opus-4-5

# AI toolbelt feature toggles (defaults shown).
# Prompt caching: caches the static system mandate so high-cadence autonomy runs
# only pay full input price for the dynamic payload (~90% input cost reduction at scale).
ENABLE_AI_PROMPT_CACHE=true
# Category routing: dispatches each candidate signal to a (platform, category) desk persona.
ENABLE_AI_CATEGORY_ROUTING=true
# Web search: enables Anthropic's hosted web_search_20250305 tool so the reviewer can
# pull fresh news context (sports lineups, crypto news, election headlines).
# Requires the Anthropic account to have web_search access enabled.
ENABLE_AI_WEB_SEARCH=true
# Extended thinking: lets Claude reason longer on high-stakes trades.
ENABLE_AI_EXTENDED_THINKING=true
# Desk memory: persistent learning tape per (user, platform, desk) injected
# into the cached system prompt so each desk learns from its own win/loss history.
ENABLE_AI_DESK_MEMORY=true
# Haiku triage: cheap pre-filter when the candidate batch is larger than
# AI_TRIAGE_THRESHOLD; drops obvious junk before paying Sonnet/Opus prices.
ENABLE_AI_TRIAGE=true
AI_TRIAGE_THRESHOLD=12
# Citations: append [cites: <hostnames>] to the reviewer reasoning when Claude
# pulled supporting context via web_search.  Surfaces the audit trail.
ENABLE_AI_CITATIONS=true

# Optional: Kalshi API key for select server-level market endpoints.
KALSHI_API_KEY=

# Optional: GNews API key for news-based sentiment.
GNEWS_API_KEY=

# Optional: URL to receive webhook POST alerts for critical operational events.
# Supports any service that accepts a JSON HTTP POST (Slack incoming webhook,
# PagerDuty Events v2, custom receiver, etc.).  Alerts are sent for:
#   - 3+ consecutive autonomy run errors for the same user
#   - Live account equity drops of ≥10% since the last sync
#   - Exchange order rejections
# Leave blank to disable alerting (safe default for local development).
ALERT_WEBHOOK_URL=

# Optional: Log level for structured logging (debug, info, warn, error)
# Defaults to 'debug' in development, 'info' in production
LOG_LEVEL=info

# Optional analytics variables; only used when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional for local dev only. Vercel sets PORT automatically.
PORT=5008
NODE_ENV=development
