# Required: Postgres connection string from Neon (use the pooled HTTP endpoint).
# https://neon.tech/docs/connect/connect-from-vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required: 32+ char secret used to sign owner session JWTs (HS256 via jose).
JWT_SECRET=replace-with-a-long-random-secret-please

# Required: 32+ char secret used to AES-encrypt Kalshi API credentials at rest.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Required: single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=founder@example.com
OWNER_PASSWORD=replace-with-a-long-owner-password

# Required for Vercel cron auth. Set the same value in vercel.json env / project settings.
# Cron jobs send: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required: OpenAI API key — the OpenAI + Claude duo trader runs only when both providers are configured.
OPENAI_API_KEY=sk-proj-...
# Optional override; defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Optional request timeout override in milliseconds; defaults to 12000.
OPENAI_TIMEOUT_MS=12000

# Required: Anthropic API key — Claude is the second half of the duo trader.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional request timeout override in milliseconds; defaults to 12000.
ANTHROPIC_TIMEOUT_MS=12000

# Optional: Kalshi API key (some endpoints work without it; live trading requires
# per-user credentials saved through the Connections page).
KALSHI_API_KEY=

# Optional: GNews API key for news-based sentiment.
GNEWS_API_KEY=

# Optional analytics variables; only used when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional: only used by the local dev server. Vercel sets PORT automatically.
PORT=5008
NODE_ENV=development
