# ──────────────────────────────────────────────────────────────────────────────
# Personal Kalshi trading dashboard — environment configuration.
# Single-owner. OpenRouter runs the primary Researcher / Quant / Executioner
# stack, Sonnet remains available for deep review, and Grok is reserved for
# urgent real-time niches when the economics justify the extra spend.
# All thresholds are PERCENTAGES — they auto-scale with live Kalshi balance.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core platform (REQUIRED) ──────────────────────────────────────────────────
# Postgres connection string from Neon (pooled endpoint in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 32+ char secret used to sign owner session JWTs (HS256 via jose).
JWT_SECRET=replace-with-a-long-random-secret-please

# 32+ char secret used with PBKDF2 (100k iterations) to encrypt at-rest secrets.
# MUST be different from JWT_SECRET.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-owner-password

# Production / development.
NODE_ENV=production
# Railway sets PORT automatically; locally pick any free port (default 3000).
# PORT=3000
# CORS allow-list for production frontend host (omit for default).
# ALLOWED_ORIGIN=https://your-railway-app.up.railway.app

# ── Kalshi Trade API (REQUIRED for trading) ──────────────────────────────────
# `false` (default) → production https://api.elections.kalshi.com
# `true`            → demo       https://demo-api.kalshi.co
DEMO_MODE=false

# Kalshi API key id — the "KALSHI-ACCESS-KEY" header value. Generate at
# https://kalshi.com/account/api (Trade API → "Create new key").
KALSHI_KEY_ID=your-kalshi-key-id

# Path to the RSA private key PEM file generated when you created the key.
# Use either KALSHI_PRIVATE_KEY_PATH (file on disk) or KALSHI_PRIVATE_KEY (inline PEM).
# Inline is preferred for Railway — paste the entire PEM, newlines as \n.
# KALSHI_PRIVATE_KEY_PATH=/secrets/kalshi-private-key.pem
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional Kalshi fee multiplier overrides (defaults match the published schedule).
# fee = round_up_to_cent(multiplier × count × price × (1 − price))
# KALSHI_MAKER_FEE_MULTIPLIER=0.0175
# KALSHI_TAKER_FEE_MULTIPLIER=0.07
# Strongly prefer maker (limit) orders — set false to allow taker fills.
# PREFER_MAKER_ORDERS=true

# ── Claude / Anthropic (legacy compatibility / optional deep review) ────────
# Anthropic vars are retained for compatibility with the legacy deep-review
# adapters. The live reviewer stack is OpenRouter-first.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_HAIKU_MODEL=claude-haiku-4-5      # Tier 1 (every signal) — cheapest
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6    # Tier 2 (high-stakes only)
# CLAUDE_OPUS_MODEL=claude-opus-4-7        # Tier 3 (gross EV ≥ 5% + Sonnet disagree)
# CLAUDE_HAIKU_TIMEOUT_MS=15000
# CLAUDE_SONNET_TIMEOUT_MS=20000
# CLAUDE_OPUS_TIMEOUT_MS=45000
# OPUS_ESCALATION_MIN_GROSS_EV=0.05        # Opus runs only above this gross-EV floor

# ── OpenRouter primary reviewer stack (REQUIRED in production) ──────────────
# Researcher / Quant / Executioner run here first. The defaults are free-tier
# models, so keep them unless a paid model is consistently earning more edge
# than it costs.
OPENROUTER_API_KEY=
OPENROUTER_RESEARCHER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_QUANT_MODEL=deepseek/deepseek-r1:free
OPENROUTER_EXECUTIONER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# Quant must clear all three true-winner thresholds before a live order is even
# considered. Raise them for a tighter book; lower them only if you have proof
# the extra volume is paying for itself.
TRUE_WINNER_MIN_SIDE_PROBABILITY=0.67
TRUE_WINNER_MIN_EDGE_FRACTION=0.08
TRUE_WINNER_MIN_ROI_FRACTION=0.12

# Optional free pre-triage. This fails open to the main OpenRouter review path
# on timeout, rate limits, or malformed output.
OPENROUTER_TRIAGE_ENABLED=true
# Strong free structured-reasoning default; change if OpenRouter rotates free models.
OPENROUTER_TRIAGE_MODEL=qwen/qwen3-235b-a22b:free
# 0 = run free pre-triage on every non-empty candidate batch. Raise to 3-6 if
# OpenRouter free-model latency ever matters more than Claude-token savings.
OPENROUTER_TRIAGE_THRESHOLD=0
OPENROUTER_TIMEOUT_MS=8000
# Optional metadata OpenRouter displays in your dashboard/analytics.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=tradingmanus-kalshi-triage

# ── Grok real-time escalation (optional, narrow by design) ──────────────────
# Grok is only for urgent weather / sports / economics setups where fresh X,
# web, NOAA, or order-book context can add real edge. If these thresholds are
# not met, the system stays on Sonnet or the OpenRouter quant result.
XAI_API_KEY=
GROK_REVIEWER_ENABLED=false
GROK_MODEL=grok-4-latest
GROK_TIMEOUT_MS=25000
GROK_WEATHER_MAX_HOURS=72
GROK_SPORTS_MAX_HOURS=24
GROK_ECONOMICS_MAX_HOURS=12
GROK_MIN_SIDE_PROBABILITY=0.75
GROK_MIN_EDGE_FRACTION=0.10
GROK_MIN_ROI_FRACTION=0.18
GROK_MIN_CONFIDENCE=0.70
# Legacy compatibility names still parse, but prefer the GROK_MIN_* names.
# GROK_ESCALATION_MIN_SIDE_PROBABILITY=0.75
# GROK_ESCALATION_MIN_EDGE_FRACTION=0.10

# ── High-stakes ensemble triggers (% of live Kalshi capital) ─────────────────
# Sonnet (Tier 2) fires when ANY of: notional ≥ HIGH_STAKES_PCT_OF_CAPITAL,
# resolution ≤ HIGH_STAKES_RESOLUTION_MINUTES, or Tier-1 self-consistency split.
HIGH_STAKES_PCT_OF_CAPITAL=0.03
HIGH_STAKES_RESOLUTION_MINUTES=1440
# Opus (Tier 3) unanimous-gate trigger.
CATASTROPHIC_PCT_OF_CAPITAL=0.10

# ── Profit guardrails (aggressive small-account tuning) ─────────────────────
# Net-EV floor (after Kalshi fees + amortized AI cost).  Default 2 % —
# aggressive volume mode for a <$1000 risk-tolerant account.  The dual-bot
# Claude+Grok consensus + drawdown breakers are the real safety net; a
# tight EV floor on top costs ~40 % of legitimate volume.  Raise to 0.05
# for conservative posture.
MIN_NET_EV=0.02
# Minimum confidence after AI reviewer adjustment.  Both reviewers must
# agree and the joint posterior must clear this floor.
MIN_CONFIDENCE_AFTER_ADJUST=0.75
# Total exposure / per-correlated-group caps.
MAX_PORTFOLIO_EXPOSURE_PCT=0.35
MAX_CORRELATED_GROUP_PCT=0.15
# Position sizing: ½ Kelly (0.5).  Long-run growth ~85 % of full-Kelly
# with 4× less drawdown variance.  KELLY_FRACTION=0.65 for ⅔ Kelly,
# 0.25 for ¼ Kelly.
KELLY_FRACTION=0.5
# Kelly clamp range.  25 % cap (was 8 %) — aggressive Kelly will bind on
# edge magnitude rather than an artificial low ceiling.
KELLY_MAX_PCT_OF_CAPITAL=0.25
KELLY_MIN_PCT_OF_CAPITAL=0.01
# OUTER cap on every order (% of live capital).  Layered on top of Kelly
# as the absolute hardest constraint per trade.  Default 4 % — at $1000
# = $40 max per trade.  Set higher for more aggressive sizing or lower
# for tighter posture.
MAX_RISK_PER_TRADE_PERCENT=4
# Minimum aggregate USD volume required to consider a market actionable.
# Below this, fills are unreliable, spreads blow out, and AI cost > edge.
# Set 0 to disable the gate (e.g., for low-volume backtests).
MIN_LIQUIDITY_USD=40000
# Drawdown circuit breakers (pause new entries on these losses).
DAILY_DRAWDOWN_PAUSE_FRAC=0.05
WEEKLY_DRAWDOWN_PAUSE_FRAC=0.12
# Cold-streak pause rules.
COLD_STREAK_LOSS_COUNT=6
COLD_STREAK_MIN_REALIZED_EDGE_PCT=0.03

# ── Dynamic scanner (capital-tier aware) ─────────────────────────────────────
# Base 5/day regardless of capital (signal-supply-bound). Max ramp scales:
#   capital ≤ MID_TIER → 8/day on high-opportunity days
#   capital > MID_TIER → 10/day
#   capital > HIGH_TIER → 12/day
SCANNER_BASE_ANALYSES_PER_DAY=5
SCANNER_MAX_ANALYSES_PER_DAY=8
SCANNER_MAX_ANALYSES_PER_DAY_MID_TIER=10
SCANNER_MAX_ANALYSES_PER_DAY_HIGH_TIER=12
SCANNER_CAP_MID_TIER_USD=500
SCANNER_CAP_HIGH_TIER_USD=2000
SCANNER_HIGH_OPP_LIQUID_MARKETS=18
SCANNER_HIGH_OPP_WEEKLY_EDGE_PCT=0.08

# ── AI cost / cadence ────────────────────────────────────────────────────────
ENABLE_AI_PROMPT_CACHE=true
ENABLE_AI_CATEGORY_ROUTING=true
ENABLE_AI_WEB_SEARCH=true
ENABLE_AI_DESK_MEMORY=true
# Hard daily loss limit (USD). When the day's realized net P&L falls below
# -DAILY_LOSS_LIMIT_USD the scheduler skips every autonomy tick until UTC
# midnight rollover. Profitable days ALWAYS run at full speed — the gate only
# fires when the account is genuinely down by more than this amount for the
# day. Set 0 to disable (no daily loss stop).
# Sizing guide: ~4-5% of account (e.g. $20 at $450, $45 at $1000).
DAILY_LOSS_LIMIT_USD=20

# ── Schedulers ───────────────────────────────────────────────────────────────
# Autonomy cron — 10 min default (600000 ms). Was 60s; Kalshi signal supply
# doesn't refresh fast enough to warrant minute-level review and the AI cost
# at 60s was not paying for itself.
AUTONOMY_INTERVAL_MS=600000
# Order/position reconciliation + exit-monitor cadence (default 30s).
ORDER_SYNC_INTERVAL_MS=30000
# Adaptive-cadence: skip AI review when a market hasn't moved this many bps
# since its last review (default 50 = 0.5%).
SIGNAL_REVIEW_PRICE_DELTA_BPS=50
# Heartbeat — re-review every market at least this often regardless of price.
SIGNAL_REVIEW_STALE_TTL_MS=600000
# `true` to auto-close positions when stop-loss / profit-target fires.
AUTO_CLOSE_ON_EXIT_SIGNAL=false

# ── Daily Sports Play (playground mode, opt-in) ──────────────────────────────
# Fires ONE Kalshi sports trade per UTC day at the configured hour, sized at
# DAILY_SPORTS_PLAY_PCT_OF_CAPITAL of live Kalshi balance. Routes through the
# same ensemble + risk gate stack as the regular autonomy loop. Calibration
# loop picks up outcomes automatically.
ENABLE_DAILY_SPORTS_PLAY=false
# Hour of the UTC day at which to fire (0-23). Default 14 = 10am ET / 7am PT.
DAILY_SPORTS_PLAY_HOUR_UTC=14
# Size as a fraction of LIVE Kalshi balance. Default 2.5 %.
DAILY_SPORTS_PLAY_PCT_OF_CAPITAL=0.025

# ── Daily Moonshot Play (aggressive lottery-ticket mode, opt-in) ─────────────
# Once per UTC day at the configured hour, picks the SINGLE highest-edge
# Kalshi underdog (ANY category) priced ≤ DAILY_MOONSHOT_MAX_PRICE where the
# AI sees materially more probability than the market is pricing. Same risk
# gate stack as the daily sports play. Calibration loop picks up outcomes.
ENABLE_DAILY_MOONSHOT=false
# UTC hour to fire (0-23). Default 16 = noon ET / 9am PT (after morning
# sports play settles into a position so cap math is accurate).
DAILY_MOONSHOT_HOUR_UTC=16
# Position size as a fraction of LIVE Kalshi balance. Default 1.5 %
# (lottery-ticket discipline; most moonshots expire worthless).
DAILY_MOONSHOT_PCT_OF_CAPITAL=0.015
# Max market price for a candidate to qualify as a moonshot (YES contracts
# ≤ this, OR equivalently NO contracts ≥ 1 - this). Default 0.30 = 30 %.
DAILY_MOONSHOT_MAX_PRICE=0.30
# AI win-probability must be ≥ this multiple of the market's implied
# probability for the trade to qualify (default 1.75 → market 10 %, AI ≥ 17.5 %).
DAILY_MOONSHOT_MIN_PROB_RATIO=1.75
# Net-EV floor for moonshots — STRICTER than the main 5 % floor because real
# moonshots produce 30-50 % net EV by structure (low contract price × decent
# edge ratio = huge per-dollar EV). 15 % filters out marginal candidates that
# just barely cleared the prob-ratio gate. Default 15 %.
DAILY_MOONSHOT_MIN_NET_EV=0.15

# ── Polymarket (OPTIONAL — second platform) ──────────────────────────────────
# Polymarket connection is fully optional.  Without these vars the Polymarket
# autonomy + cross-arb scanner audit-log "skipped — user not subscribed" and
# everything else keeps running.  When you connect Polymarket creds via the
# dashboard's settings page, those creds are stored AES-256-GCM encrypted in
# `polymarketCredentials` and the Polymarket scheduler picks them up
# automatically.
#
# `POLYMARKET_OWNER_ADDRESS` is your EOA proxy wallet (the 0x… address shown
# on https://polymarket.com/settings).  Used for the unauthenticated
# `data-api.polymarket.com/positions` reconciliation that detects manual UI
# closes.  Without it the position-sync silently no-ops; you'll see a
# `[SelfTest] WARN polymarket_owner_address` line at boot.
# POLYMARKET_OWNER_ADDRESS=0xYourPolymarketProxyWallet

# Polymarket LIVE order placement is ON by default — EIP-712 signing is
# implemented via @polymarket/clob-client.  Placement still requires the
# user's `polymarketCredentials` row to carry: apiKey + apiSecret +
# apiPassphrase (CLOB L2 creds) PLUS walletPrivateKey + walletAddress +
# signatureType (the EOA signing key + funder address + 0=EOA / 1=POLY_PROXY
# / 2=POLY_GNOSIS_SAFE).  Most Polymarket UI users land on POLY_PROXY (1).
# Set this env to false to disable Polymarket order placement entirely as a
# kill-switch — read-side paths (Gamma market scan, cross-arb DETECTION,
# position reconciliation) keep working either way.
# POLYMARKET_LIVE_TRADING_ENABLED=true

# Cross-platform arbitrage scanner cadence (default 10s).  Detection-only by
# default — opportunities surface in the audit log as `cross_platform_arb_detected`.
# Auto-execution requires CROSS_ARB_AUTO_EXECUTE=true AND connected creds on
# both platforms AND a tested two-leg execution path (currently OFF).
# CROSS_ARB_INTERVAL_MS=10000

# ── Misc / monitoring ────────────────────────────────────────────────────────
# Optional GNews API key for sentiment heuristics.
# GNEWS_API_KEY=...
# Optional Slack/Discord/PagerDuty webhook for ops alerts.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Audit log retention (days). Default 90.
# AUDIT_LOG_RETENTION_DAYS=90

# Global emergency kill-switch: when true, no live orders are placed.
# (Single-owner live mode otherwise — owner is always live unless this is set.)
PAPER_TRADE_MODE=false
