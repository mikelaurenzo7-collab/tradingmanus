# Required: Postgres connection string from Neon (use the pooled HTTP endpoint).
# https://neon.tech/docs/connect/connect-from-vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required: 32+ char secret used to sign owner session JWTs (HS256 via jose).
JWT_SECRET=replace-with-a-long-random-secret-please

# Required: 32+ char secret used to AES-encrypt Kalshi API credentials at rest.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Required: single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=mikelaurenzo7@gmail.com
OWNER_PASSWORD=chet1212!chet1212

# Required for Vercel cron auth. Set the same value in vercel.json env / project settings.
# Cron jobs send: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required: Anthropic API key — Claude is the autonomous trader's final reviewer.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Kalshi API key (some endpoints work without it; live trading requires
# per-user credentials saved through the Connections page).
KALSHI_API_KEY=

# Optional: GNews API key for news-based sentiment.
GNEWS_API_KEY=

# Optional: only used by the local dev server. Vercel sets PORT automatically.
PORT=5008
NODE_ENV=development
NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://user:password@localhost:3306/tradingmanus
JWT_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-separate-long-random-secret

VITE_APP_ID=replace-with-your-manus-app-id
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
OAUTH_SERVER_URL=https://your-oauth-server.example.com

OWNER_OPEN_ID=replace-with-your-owner-open-id
KALSHI_API_KEY=

# Optional Manus Forge proxy endpoints for non-Kalshi auxiliary features.
# These are not Kalshi credentials and are not required for core Kalshi trading.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

GNEWS_API_KEY=
