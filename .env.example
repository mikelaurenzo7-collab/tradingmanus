# Required: Postgres connection string from Neon (use pooled endpoint in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required: 32+ char secret used to sign owner session JWTs (HS256 via jose).
# JWT access tokens now expire in 24 hours (was 1 year). Refresh tokens expire in 7 days.
JWT_SECRET=replace-with-a-long-random-secret-please

# Required: 32+ char secret used with PBKDF2 (100k iterations) to encrypt Kalshi API credentials at rest.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Required: single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-owner-password

# Required: Claude is the sole AI reviewer for both Kalshi and Polymarket.
# The bots route each candidate signal through a category-specialized desk
# persona (sports / crypto / politics / economics / tech / culture / weather).
# All AI calls are routed through OpenRouter using the tencent/hy3-preview:free model.
#
# Primary key — use OPENROUTER_API_KEY (get one at https://openrouter.ai):
OPENROUTER_API_KEY=sk-or-...
# Backward-compatible fallback: if OPENROUTER_API_KEY is not set, the app will
# use ANTHROPIC_API_KEY instead (helpful during migration from Anthropic).
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the OpenRouter model (defaults to tencent/hy3-preview:free).
# OPENROUTER_MODEL=tencent/hy3-preview:free
# Optional request timeout override in milliseconds; defaults to 12000.
ANTHROPIC_TIMEOUT_MS=12000
# Optional: deep-tier timeout override in milliseconds; defaults to 25000.
ANTHROPIC_DEEP_TIMEOUT_MS=25000

# NEW: Grok (xAI) API key for adding Grok as a trader (solo or team with Claude).
# Get one at https://console.x.ai/
XAI_API_KEY=sk-xai-...
# Optional: Grok model (defaults to grok-3-latest or grok-2-1212)
GROK_MODEL=grok-3-latest

# AI toolbelt feature toggles (defaults shown).
# Prompt caching: data structures retained for internal use; no effect on OpenRouter requests.
ENABLE_AI_PROMPT_CACHE=true
# Category routing: dispatches each candidate signal to a (platform, category) desk persona.
ENABLE_AI_CATEGORY_ROUTING=true
# Web search and extended thinking are Anthropic-only features and are disabled
# when routing through OpenRouter. These env vars have no effect.
# ENABLE_AI_WEB_SEARCH=false
# ENABLE_AI_EXTENDED_THINKING=false
# Desk memory: persistent learning tape per (user, platform, desk) injected
# into the system prompt so each desk learns from its own win/loss history.
ENABLE_AI_DESK_MEMORY=true
# Haiku triage: cheap pre-filter when the candidate batch is larger than
# AI_TRIAGE_THRESHOLD; drops obvious junk before the bulk reviewer.
# High-stakes candidates are always force-kept regardless of triage outcome.
ENABLE_AI_TRIAGE=true
AI_TRIAGE_THRESHOLD=6
# Citations: append [cites: <hostnames>] to the reviewer reasoning.
# Note: citations are only generated when the model returns source URLs.
# With OpenRouter / tencent/hy3-preview:free this is typically not supported.
ENABLE_AI_CITATIONS=true
# Intra-model second opinion: when the bulk reviewer approves a non-high-stakes
# trade but tugs confidence down (>=0.10) or moves expected value materially
# (>=0.05), escalate just that single market to a deep second pass.
# Both must agree to keep the trade; disagreement drops it.
ENABLE_AI_INTRA_ESCALATION=true

# Optional: Kalshi API key for select server-level market endpoints.
KALSHI_API_KEY=

# Optional: GNews API key for news-based sentiment.
GNEWS_API_KEY=

# Optional: Full base URL of your production frontend to add to the CORS allow-list
# (e.g. https://app.example.com or your Railway public domain).
# Leave blank in local development (localhost origins are always allowed in dev).
ALLOWED_ORIGIN=

# Optional scheduler tuning (Railway in-process schedulers).
# AUTONOMY_INTERVAL_MS controls Kalshi + Polymarket cadence.  Default 120000 (2 min).
# Smaller = more alpha capture, more AI cost; AI free tier may rate-limit below 5 min.
# AUTONOMY_INTERVAL_MS=120000
# ORDER_SYNC_INTERVAL_MS=30000
# CROSS_ARB_INTERVAL_MS=10000

# Auto-close open positions when the exit monitor detects a stop-loss or
# profit-target trigger.  Default false: only emit a `kalshi_position_exit_signal`
# audit event so the operator can validate the signals are sensible before
# enabling real liquidation.  Flip to `true` once you're comfortable.
# AUTO_CLOSE_ON_EXIT_SIGNAL=false

# Polymarket EOA proxy wallet address (the 0x… address shown on your
# Polymarket account / deposit page).  Used by the position-sync
# reconciliation that runs every order-sync tick to detect manual UI
# closes and refresh mark prices.  Without this set the sync silently
# no-ops — the exit monitor will keep trying to close positions you
# already closed manually.  Leave blank ONLY if you never use the
# Polymarket UI directly.
POLYMARKET_OWNER_ADDRESS=

# Adaptive cadence — skips the AI reviewer for markets whose price hasn't
# moved materially since the last review.  Cuts AI cost ~3-5x and lets
# you tighten AUTONOMY_INTERVAL_MS to 60s on the same daily budget.
# SIGNAL_REVIEW_PRICE_DELTA_BPS=50      # 50 bps = 0.5%; min price move to re-review
# SIGNAL_REVIEW_STALE_TTL_MS=600000     # 10 min heartbeat: re-review even quiet markets at least this often

# Optional: URL to receive webhook POST alerts for critical operational events.
# Supports any service that accepts a JSON HTTP POST (Slack incoming webhook,
# PagerDuty Events v2, custom receiver, etc.).  Alerts are sent for:
#   - 3+ consecutive autonomy run errors for the same user
#   - Live account equity drops of ≥10% since the last sync
#   - Exchange order rejections
# Leave blank to disable alerting (safe default for local development).
ALERT_WEBHOOK_URL=

# Optional: Enable paper trading mode. When true, all orders are simulated at
# Paper-trade behaviour is now PER-USER (server/_core/effectivePaperMode.ts):
#   - PAPER_TRADE_MODE=true → GLOBAL emergency override: every user (incl.
#     owner) goes to the simulator.  Use this to halt all real trading.
#   - PAPER_TRADE_MODE=false (or unset) → owner (OWNER_EMAIL) trades LIVE
#     by default; any other user is forced into paper until they graduate.
# Simulated trades still record to desk memory and influence learning
# feedback.  Withdrawals are blocked in paper mode.
PAPER_TRADE_MODE=false

# Optional: Log level for structured logging (debug, info, warn, error)
# Defaults to 'debug' in development, 'info' in production
LOG_LEVEL=info

# Optional analytics variables; only used when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional for local dev only. Railway sets PORT automatically.
PORT=5008
NODE_ENV=development
