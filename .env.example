# Required: Postgres connection string from Neon (use pooled endpoint in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required: 32+ char secret used to sign owner session JWTs (HS256 via jose).
# JWT access tokens now expire in 24 hours (was 1 year). Refresh tokens expire in 7 days.
JWT_SECRET=replace-with-a-long-random-secret-please

# Required: 32+ char secret used with PBKDF2 (100k iterations) to encrypt Kalshi API credentials at rest.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Required: single-owner login credentials. Production OWNER_PASSWORD must be 12+ chars.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-owner-password

# Required in production for Vercel cron auth. Must be at least 32 characters in production.
# Cron jobs send: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required: Claude is now the primary reviewer for both Kalshi and Polymarket.
# The bots route each candidate signal through a category-specialized desk
# persona (sports / crypto / politics / economics / tech / culture / weather)
# with prompt caching, web_search, and extended thinking enabled.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5 for normal-stakes review.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional request timeout override in milliseconds; defaults to 12000.
ANTHROPIC_TIMEOUT_MS=12000
# Optional: cheap/fast model used for triage filtering (defaults to claude-haiku-4-5).
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5
# Optional: deep-reasoning model used on high-stakes trades when extended thinking is on.
ANTHROPIC_DEEP_MODEL=claude-opus-4-5

# Optional: OpenAI is now a *fallback* and high-stakes second-opinion reviewer.
# - When configured, OpenAI is consulted in parallel with Claude.
# - On normal-stakes trades, Claude's verdict is the gate; OpenAI is ignored unless
#   Claude failed to return a review for that market (then OpenAI is the fallback gate).
# - On high-stakes trades (notional ≥ $25, near-resolution, or confidence ≥ 0.9) BOTH
#   providers must approve.
# Trading is fully functional with Claude alone; OpenAI is recommended but optional.
OPENAI_API_KEY=
# Optional override; defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Optional request timeout override in milliseconds; defaults to 12000.
OPENAI_TIMEOUT_MS=12000

# AI toolbelt feature toggles (defaults shown).
# Prompt caching: caches the static system mandate so high-cadence autonomy runs
# only pay full input price for the dynamic payload (~90% input cost reduction at scale).
ENABLE_AI_PROMPT_CACHE=true
# Category routing: dispatches each candidate signal to a (platform, category) desk persona.
ENABLE_AI_CATEGORY_ROUTING=true
# Web search: enables Anthropic's hosted web_search_20250305 tool so the reviewer can
# pull fresh news context (sports lineups, crypto news, election headlines).
# Requires the Anthropic account to have web_search access enabled.
ENABLE_AI_WEB_SEARCH=true
# Extended thinking: lets Claude reason longer on high-stakes trades.
ENABLE_AI_EXTENDED_THINKING=true
# Desk memory: persistent learning tape per (user, platform, desk) injected
# into the cached system prompt so each desk learns from its own win/loss history.
ENABLE_AI_DESK_MEMORY=true
# Haiku triage: cheap pre-filter when the candidate batch is larger than
# AI_TRIAGE_THRESHOLD; drops obvious junk before paying Sonnet/Opus prices.
ENABLE_AI_TRIAGE=true
AI_TRIAGE_THRESHOLD=12
# Citations: append [cites: <hostnames>] to the reviewer reasoning when Claude
# pulled supporting context via web_search.  Surfaces the audit trail.
ENABLE_AI_CITATIONS=true
# Cross-platform arbitrage AI gate.  When ON (default), executeCrossArb
# refuses to fire any cross-arb without Claude sign-off; ANTHROPIC_API_KEY
# must be set for any execution to proceed.  Set to false only if you
# want to bypass the AI gate for cross-arb.
ENABLE_AI_ARBITRAGE_REVIEW=true
# Minimum sizeFraction the arbitrage reviewer must return for a cross-arb
# to proceed (0..1).  Below this is treated as a soft veto.  Default 0.10.
AI_ARBITRAGE_MIN_SIZE_FRACTION=0.10
# Shadow trading mode.  When ON, the autonomy loops run through the full
# pipeline (signals + AI review) but do NOT place real orders — instead
# they write *_shadow_order_intent audit-log events recording what would
# have traded.  Use this to validate edge for several weeks before
# enabling live trading on real capital.  Default OFF.
SHADOW_TRADING_MODE=false

# Kelly-fractional position sizing.  When ON, each bet is shrunk to the
# fractional Kelly recommendation (capped by per-trade and equity-fraction
# limits).  Default OFF — flip on once shadow-mode results justify it.
ENABLE_KELLY_SIZING=false
# Fraction of full Kelly to deploy.  0.25 = quarter Kelly (recommended
# starting point).  Lower = safer drawdown profile, lower theoretical growth.
KELLY_FRACTION=0.25
# Hard cap on any single bet as a fraction of equity.  Default 5%.
KELLY_MAX_EQUITY_FRACTION=0.05

# Cold-start sizing.  Scale orders down for new accounts until either a
# time threshold (days) or trade count is reached, whichever first.
ENABLE_COLD_START_SIZING=true
COLD_START_SIZE_FLOOR=0.10   # Start at 10% size
COLD_START_DAYS=30           # Or 30 days...
COLD_START_TRADES=30         # ...or 30 completed trades, whichever first.

# Concentration limits.  Block new positions that overlap with existing
# open positions or breach a category cap.
ENABLE_CONCENTRATION_LIMITS=true
CONCENTRATION_SIMILARITY_THRESHOLD=0.5     # Jaccard token overlap of question text.
CONCENTRATION_CATEGORY_CAP_FRACTION=0.2    # Max 20% of equity per category.

# Stop-loss + time-stop scanner.  Runs on its own cron tick and closes open
# Kalshi positions that have hit either threshold.  Polymarket parity is
# pending a positions table.
ENABLE_STOP_LOSS_SCANNER=true
STOP_LOSS_LOSS_FRACTION=0.3      # Close at -30% of entry exposure.
STOP_LOSS_MAX_HOLD_HOURS=72      # Or after 72 hours, whichever first.

# Operator alerts.  When set, kill-switch / circuit-breaker / stop-loss
# events POST a small JSON payload.  Slack and Discord generic webhooks work.
ALERTS_WEBHOOK_URL=

# Optional: Kalshi API key for select server-level market endpoints.
KALSHI_API_KEY=

# Optional: GNews API key for news-based sentiment.
GNEWS_API_KEY=

# Optional: Log level for structured logging (debug, info, warn, error)
# Defaults to 'debug' in development, 'info' in production
LOG_LEVEL=info

# Optional analytics variables; only used when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional for local dev only. Vercel sets PORT automatically.
PORT=5008
NODE_ENV=development
