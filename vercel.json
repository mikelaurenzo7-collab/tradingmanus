{
  "version": 2,
  "framework": "vite",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/scheduled/autonomous-trading",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/scheduled/order-sync",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
